# ============================================================
# .env.example  ->  `cp .env.example .env` ve değerleri doldur
# UYARI: .env dosyası ASLA commit edilmez (.gitignore'da tanımlı).
# ============================================================

# ---------- OpenAI ----------
OPENAI_API_KEY=sk-**************************************
OPENAI_MODEL=prefered_model
OPENAI_TEMPERATURE=0.0
OPENAI_MAX_TOKENS=4096
OPENAI_REQUEST_TIMEOUT=60
# Azure/proxy kullanılıyorsa:
# OPENAI_BASE_URL=https://api.openai.com/v1

# ---------- PostgreSQL ----------
POSTGRES_URL=**********
POSTGRES_SCHEMA=public
POSTGRES_POOL_SIZE=5
POSTGRES_STATEMENT_TIMEOUT_MS=30000

# ---------- Veri Katmanı (DuckDB / Parquet) ----------
DATA_DIR=./data/processed
DUCKDB_PATH=:memory:
DUCKDB_THREADS=4
DUCKDB_MEMORY_LIMIT=4GB

# ---------- MCP Sunucuları ----------
MCP_DUCKDB_SERVER_CMD=python
MCP_DUCKDB_SERVER_ARGS=-m,src.mcp_servers.duckdb_server
MCP_POSTGRES_SERVER_CMD=python
MCP_POSTGRES_SERVER_ARGS=-m,src.mcp_servers.postgres_server
MCP_TOOL_TIMEOUT=60

# ---------- Agent / Guardrails ----------
MAX_RETRIES=3
MAX_ROWS_RETURNED=1000
ALLOW_WRITE_QUERIES=false
QUERY_TIMEOUT_SECONDS=30

# ---------- Gözlemlenebilirlik ----------
LOG_LEVEL=INFO
LOG_FILE=./logs/copilot.log
# LangSmith ile trace almak istersen:
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls__xxxxxxxxxxxx
# LANGCHAIN_PROJECT=lakehouse-copilot
