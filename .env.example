# .env.example  ->  `cp .env.example .env` ve değerleri doldur

# OpenAI
OPENAI_API_KEY=sk-**************************************
OPENAI_MODEL=gpt-4o
OPENAI_SQL_TEMPERATURE=0.0
OPENAI_SUMMARY_TEMPERATURE=0.3
OPENAI_MAX_TOKENS=4096
OPENAI_REQUEST_TIMEOUT=60
# Azure/proxy kullanılıyorsa:
# OPENAI_BASE_URL=https://api.openai.com/v1

# PostgreSQL
POSTGRES_URL=**********
POSTGRES_SCHEMA=public
POSTGRES_POOL_SIZE=5
POSTGRES_STATEMENT_TIMEOUT_MS=30000

# Veri Katmanı (DuckDB / Parquet)
DATA_DIR=./data/processed
DUCKDB_PATH=:memory:
DUCKDB_THREADS=4
DUCKDB_MEMORY_LIMIT=4GB

# MCP Sunucuları
MCP_DUCKDB_SERVER_CMD=python
MCP_DUCKDB_SERVER_ARGS=-m,src.mcp_servers.duckdb_server
MCP_POSTGRES_SERVER_CMD=python
MCP_POSTGRES_SERVER_ARGS=-m,src.mcp_servers.postgres_server
MCP_TOOL_TIMEOUT=60
MCP_TRANSPORT=stdio

# HTTP transport (MCP_TRANSPORT=http iken aktif)
MCP_DUCKDB_HTTP_URL=http://127.0.0.1:8001/mcp
MCP_DUCKDB_HTTP_HOST=127.0.0.1
MCP_DUCKDB_HTTP_PORT=8001
MCP_POSTGRES_HTTP_URL=http://127.0.0.1:8002/mcp
MCP_POSTGRES_HTTP_HOST=127.0.0.1
MCP_POSTGRES_HTTP_PORT=8002


# Agent / Guardrails
MAX_RETRIES=3
MAX_ROWS_RETURNED=1000
ALLOW_WRITE_QUERIES=false
QUERY_TIMEOUT_SECONDS=30
APPROVAL_ROW_THRESHOLD=5000   # 0 = devre dışı

# Gözlemlenebilirlik
LOG_LEVEL=INFO
LOG_FILE=./logs/copilot.log

# LangSmith tracing (isteğe bağlı)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=ls-...
LANGCHAIN_PROJECT=lakehouse-copilot
LANGCHAIN_ENDPOINT=https://eu.api.smith.langchain.com #EU bölgesindeyse

